#!/usr/bin/env bash

# Ensure Nix is available in PATH
if ! command -v nix &> /dev/null; then
  if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
    . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
  elif [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
  elif [ -d "/nix/var/nix/profiles/default/bin" ]; then
    export PATH="/nix/var/nix/profiles/default/bin:$PATH"
  fi
fi

# Use nix-direnv if available or fetch it for fast caching
if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi


# Load project-local .direnvrc helper functions if present
if [ -f .direnvrc ]; then
  source_env .direnvrc
fi

use flake


# Load environment variables
export RUST_LOG=info
export DATABASE_URL="sqlite://jakewray.db"
export RUST_BACKTRACE=1

# Optional: Print helpful info when entering directory
if [ -z "$JAKEWRAY_INIT" ]; then
  export JAKEWRAY_INIT=1
  echo "🚀 jakewray.dev devenv ready"
fi